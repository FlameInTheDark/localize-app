# Wails, installer, and frontend build output
/build/bin/
/build/windows/installer/tmp/
/frontend/dist/
/frontend/node_modules/
/frontend/.vite/
/frontend/package.json.md5
/frontend/*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts
/.wails/

# Native runtimes are acquired after installation and never belong in this repository
/runtime/

# Go build, test, profile, and coverage output
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.prof
*.pprof
coverage.out
coverage.txt

# Local configuration and credentials
.env
.env.*
!.env.example
*.local

# Package-manager diagnostics and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
.cache/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
